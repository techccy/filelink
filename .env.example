# 上传令牌：网页首次打开时填入，仅校验上传，下载不需要
UPLOAD_TOKEN=change-me-to-a-long-random-string

# Cloudflare Tunnel 令牌（Zero Trust -> Networks -> Tunnels -> 创建后获取）
TUNNEL_TOKEN=

# 生成公链用的对外地址（tunnel 域名），如 https://f.example.com
# 留空则从请求头自动推导（cloudflared 会带 X-Forwarded-Proto）
BASE_URL=

# 单文件大小上限（MB）。注意 Cloudflare 免费版代理的请求体上限为 100MB
MAX_SIZE_MB=100

# 链接默认有效期，Go duration 格式；续期一次 + 同样时长
UPLOAD_TTL=2h

# 过期清理间隔
CLEANUP_INTERVAL=1h

# 上传令牌：仅校验上传，下载不需要
UPLOAD_TOKEN=change-me-to-a-long-random-string

# 生成公链用的对外地址，如 https://f.example.com
# 留空则从请求头自动推导（反向代理需转发 X-Forwarded-Proto: https）
BASE_URL=

# 单文件大小上限（MB）。若经 Cloudflare 免费版代理，请求体上限为 100MB
MAX_SIZE_MB=100

# 链接默认有效期，Go duration 格式；续期一次 + 同样时长
UPLOAD_TTL=2h

# 过期清理间隔
CLEANUP_INTERVAL=1h

# 宿主机端口绑定（docker-compose.yml 的 ports 用）
# 默认只绑回环，供同机反向代理 / 隧道转发；直接对外暴露改为 "0.0.0.0:8080"
FILELINK_BIND=127.0.0.1:8080

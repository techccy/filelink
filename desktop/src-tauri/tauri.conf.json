{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "filelink",
  "mainBinaryName": "filelink",
  "version": "0.1.0",
  "identifier": "filelink",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popover",
        "title": "filelink",
        "url": "index.html",
        "width": 380,
        "height": 640,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "hiddenTitle": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/32x32.png", "icons/128x128.png"],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}
